import os, cv2
import numpy as np
from skimage.morphology import skeletonize

CAMINHO_IMAGEM = "Projeto1/_Eucalipto_Escolhidos2/Eucalipto{}.jpg"
SAIDA = "Projeto1/Guido/saida_contagem"
REFERENCIAS = [11, 12, 12, 13, 4]

CORTE_ALTURA = 0.64
HSV_MIN = np.array([18, 38, 38], dtype=np.uint8)
HSV_MAX = np.array([96, 255, 255], dtype=np.uint8)
K8 = np.array([[1,1,1],[1,0,1],[1,1,1]], dtype=np.uint8)

def segmentar(img):
    img = img[: int(img.shape[0] * CORTE_ALTURA), :]
    hsv = cv2.cvtColor(cv2.GaussianBlur(img, (5,5), 0), cv2.COLOR_BGR2HSV)
    mask = cv2.inRange(hsv, HSV_MIN, HSV_MAX)

    # 🔥 refinamento importante
    mask = cv2.medianBlur(mask, 5)
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((9,9), np.uint8))
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3,3), np.uint8))

    return img, mask

def eixo_caule(mask, n=25):
    h, w = mask.shape
    skel = skeletonize(mask > 0).astype(np.uint8)
    cortes = np.linspace(0, h, n+1).astype(int)

    xs_med = []
    ys_med = []

    x_ant = w/2
    for y0, y1 in zip(cortes[-2::-1], cortes[:0:-1]):
        _, xs = np.where(skel[y0:y1] > 0)
        if len(xs) > 4:
            prox = xs[np.abs(xs - x_ant) < 120]
            xs_use = prox if len(prox) > 2 else xs
            x_ant = np.median(xs_use)
            xs_med.append(x_ant)
            ys_med.append((y0+y1)/2)

    if len(xs_med) < 2:
        return np.array([0,h]), np.array([w/2,w/2])

    return np.array(ys_med[::-1]), np.array(xs_med[::-1])

def x_caule(y, ey, ex):
    return np.interp(y, ey, ex)

def ang_diff(a,b):
    d = abs(a-b)%180
    return min(d,180-d)

def comp_info(pts, ey, ex):
    cx, cy = pts.mean(axis=0)

    cov = np.cov((pts-[cx,cy]).T)
    vals, vecs = np.linalg.eigh(cov)
    vx, vy = vecs[:, np.argmax(vals)]
    ang = (np.degrees(np.arctan2(vy,vx))+180)%180

    dx = np.ptp(pts[:,0])+1
    dy = np.ptp(pts[:,1])+1

    dist = np.mean(np.abs(pts[:,0]-x_caule(pts[:,1], ey, ex)))

    return {"pts":pts,"cx":cx,"cy":cy,"ang":ang,"n":len(pts),
            "dx":dx,"dy":dy,"dist":dist}

def componentes(mask, ey, ex):
    h,w = mask.shape
    skel = skeletonize(mask>0).astype(np.uint8)
    grau = cv2.filter2D(skel, -1, K8)
    seg = (skel>0) & (grau<=2)

    n, labels, stats, _ = cv2.connectedComponentsWithStats(seg.astype(np.uint8), 8)

    comps=[]
    for i in range(1,n):
        if stats[i,cv2.CC_STAT_AREA] < max(6,int(0.003*h)):
            continue

        ys,xs = np.where(labels==i)
        c = comp_info(np.column_stack([xs,ys]), ey, ex)

        # 🔥 filtro de caule menos agressivo
        vertical = ang_diff(c["ang"],90)<25
        central = c["dist"] < 0.010*w

        if not (central and vertical and c["dy"]>c["dx"]*1.2):
            c["H"]=h; c["W"]=w
            comps.append(c)

    return skel, comps

def mesmo(a,b):
    h=max(a["H"],b["H"])

    dist = np.hypot(a["cx"]-b["cx"], a["cy"]-b["cy"])
    ang = ang_diff(a["ang"], b["ang"])

    return dist < 0.07*h and ang < 35

def agrupar(comps):
    grupos=[]
    for c in sorted(comps, key=lambda x:(x["cy"],x["cx"])):
        ok=False
        for g in grupos:
            if any(mesmo(c,r) for r in g["itens"]):
                g["itens"].append(c)
                ok=True
                break
        if not ok:
            grupos.append({"itens":[c]})
    return grupos

# 🔥 divisão de grupos grandes
def dividir_grandes(grupos, largura):
    novos=[]
    for g in grupos:
        pts = np.vstack([c["pts"] for c in g["itens"]])
        x,y,w,h = cv2.boundingRect(pts.astype(np.int32))

        if w > 0.18*largura:
            try:
                from sklearn.cluster import KMeans
                k=2
                labels = KMeans(n_clusters=k,n_init=5).fit_predict(pts)
                for i in range(k):
                    novos.append({"itens":[{"pts":pts[labels==i]}]})
            except:
                novos.append(g)
        else:
            novos.append(g)
    return novos

def desenhar(img, grupos):
    out = img.copy()
    for i,g in enumerate(grupos,1):
        pts = np.vstack([c["pts"] for c in g["itens"]]).astype(np.int32)
        x,y,w,h = cv2.boundingRect(pts)

        cor = (40+(53*i)%200,200-(31*i)%150,60+(47*i)%180)
        cv2.rectangle(out,(x,y),(x+w,y+h),cor,2)
        cv2.putText(out,str(i),(x,y-5),0,0.6,cor,2)

    cv2.putText(out,f"Folhas: {len(grupos)}",(30,50),0,1.2,(255,255,255),3)
    return out

os.makedirs(SAIDA,exist_ok=True)
erros=[]

for i,ref in enumerate(REFERENCIAS,1):
    img = cv2.imread(CAMINHO_IMAGEM.format(i))
    if img is None: continue

    img,mask = segmentar(img)
    ey,ex = eixo_caule(mask)

    _, comps = componentes(mask, ey, ex)
    grupos = dividir_grandes(agrupar(comps), img.shape[1])

    est = len(grupos)
    erros.append(abs((est-ref)/ref)*100)

    print(f"Eucalipto{i}: folhas={est} ref={ref}")
    cv2.imwrite(f"{SAIDA}/eucalipto{i}.png", desenhar(img, grupos))

print("MAPE:", np.mean(erros))