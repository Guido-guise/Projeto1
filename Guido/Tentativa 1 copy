import os
import cv2
import numpy as np


def limpar_componentes_pequenos(mask, area_minima):
    num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(mask, connectivity=8)
    mask_limpa = np.zeros_like(mask)

    for label in range(1, num_labels):
        area = stats[label, cv2.CC_STAT_AREA]
        if area >= area_minima:
            mask_limpa[labels == label] = 255

    return mask_limpa


def remover_componentes_esguios(mask, short_side_max=12, aspect_min=4.0):
    out = np.zeros_like(mask)
    contornos, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    for cnt in contornos:
        area = cv2.contourArea(cnt)
        if area < 40:
            continue

        (_, _), (w, h), _ = cv2.minAreaRect(cnt)
        lado_curto = min(w, h)
        lado_longo = max(w, h)
        aspect = (lado_longo / lado_curto) if lado_curto > 0 else 999.0

        # Remove estruturas tipicas de galho: muito finas e alongadas.
        if lado_curto <= short_side_max and aspect >= aspect_min:
            continue

        cv2.drawContours(out, [cnt], -1, 255, thickness=cv2.FILLED)

    return out


def remover_estruturas_finas(mask, min_half_thickness=4.0):
    dist = cv2.distanceTransform(mask, cv2.DIST_L2, 3)
    base = np.uint8(dist >= min_half_thickness) * 255

    # Recupera um pouco da forma das folhas sem religar galhos muito finos.
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3))
    base = cv2.dilate(base, kernel, iterations=1)
    return base


def extrair_folhas_sem_galho(img, largura_saida=300):
    altura, largura, _ = img.shape
    ini = int(altura * 0.69)
    rec = img[0:ini, 0:largura]
    hsv = cv2.cvtColor(rec, cv2.COLOR_BGR2HSV)

    lower_azul = np.array([100, 120, 150], dtype=np.uint8)
    upper_azul = np.array([120, 255, 255], dtype=np.uint8)
    mask_fundo = cv2.inRange(hsv, lower_azul, upper_azul)
    mask_planta = cv2.bitwise_not(mask_fundo)

    # Faixa de cor mais focada em tons de folha.
    lower_folha = np.array([25, 25, 50], dtype=np.uint8)
    upper_folha = np.array([90, 255, 255], dtype=np.uint8)
    mask_folha = cv2.inRange(hsv, lower_folha, upper_folha)
    mask = cv2.bitwise_and(mask_folha, mask_planta)

    kernel_open = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
    kernel_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel_open, iterations=1)
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel_close, iterations=1)

    # Etapa principal para remover twig/galho fino conectado a folhas.
    mask = remover_estruturas_finas(mask, min_half_thickness=4.0)
    kernel_refino = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel_refino, iterations=1)
    mask = limpar_componentes_pequenos(mask, area_minima=350)
    mask = remover_componentes_esguios(mask, short_side_max=12, aspect_min=4.0)

    pontos = cv2.findNonZero(mask)
    if pontos is None:
        return np.zeros((largura_saida, largura_saida, 3), dtype=np.uint8)

    x, y, w, h = cv2.boundingRect(pontos)
    margem = 18
    x0 = max(0, x - margem)
    y0 = max(0, y - margem)
    x1 = min(rec.shape[1], x + w + margem)
    y1 = min(rec.shape[0], y + h + margem)

    recorte = rec[y0:y1, x0:x1]
    mask_recorte = mask[y0:y1, x0:x1]
    resultado = cv2.bitwise_and(recorte, recorte, mask=mask_recorte)

    h_out = max(1, int(largura_saida * (resultado.shape[0] / resultado.shape[1])))
    return cv2.resize(resultado, (largura_saida, h_out))


def centralizar_em_canvas(img, largura=300, altura=300):
    canvas = np.zeros((altura, largura, 3), dtype=np.uint8)
    h, w = img.shape[:2]

    y0 = max(0, (altura - h) // 2)
    x0 = max(0, (largura - w) // 2)
    y1 = min(altura, y0 + h)
    x1 = min(largura, x0 + w)

    canvas[y0:y1, x0:x1] = img[: y1 - y0, : x1 - x0]
    return canvas


img_1 = cv2.imread("Projeto1/_Eucalipto_Escolhidos1/Eucalipto1.jpg", cv2.IMREAD_COLOR)
img_2 = cv2.imread("Projeto1/_Eucalipto_Escolhidos1/Eucalipto2.jpg", cv2.IMREAD_COLOR)
img_3 = cv2.imread("Projeto1/_Eucalipto_Escolhidos1/Eucalipto3.jpg", cv2.IMREAD_COLOR)
img_4 = cv2.imread("Projeto1/_Eucalipto_Escolhidos1/Eucalipto4.jpg", cv2.IMREAD_COLOR)
img_5 = cv2.imread("Projeto1/_Eucalipto_Escolhidos1/Eucalipto5.jpg", cv2.IMREAD_COLOR)

imagens = [img_1, img_2, img_3, img_4, img_5]
processadas = []

for i, img in enumerate(imagens, start=1):
    folhas = extrair_folhas_sem_galho(img, largura_saida=300)
    folhas = centralizar_em_canvas(folhas, largura=300, altura=300)
    processadas.append(folhas)

while len(processadas) < 6:
    processadas.append(np.zeros((300, 300, 3), dtype=np.uint8))

linha1 = np.hstack(processadas[:3])
linha2 = np.hstack(processadas[3:6])
grid = np.vstack([linha1, linha2])

saida_dir = "Projeto1/Guido/saida_tentativa1_copy"
os.makedirs(saida_dir, exist_ok=True)
cv2.imwrite(os.path.join(saida_dir, "grid_folhas_sem_galho.png"), grid)

for i in range(5):
    cv2.imwrite(os.path.join(saida_dir, f"folhas_{i + 1}.png"), processadas[i])

cv2.imshow("Folhas sem galho", grid)
cv2.waitKey(0)
cv2.destroyAllWindows()
