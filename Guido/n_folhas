import cv2
import numpy as np
import matplotlib.pyplot as plt
from skimage.morphology import skeletonize

# 1) Ler imagem original.
img_1 = cv2.imread("Projeto1/_Eucalipto_Escolhidos2/Eucalipto1.jpg", cv2.IMREAD_COLOR)

# 2) Aplicar a logica simples do arquivo "corte".
# Cortamos em 69% da altura para remover boa parte do vaso/base.
altura, largura, _ = img_1.shape
ini = int(altura * 0.69)
recorte_superior = img_1[0:ini, 0:largura]

# 3) Detectar fundo azul para isolar a planta.
recorte_hsv = cv2.cvtColor(recorte_superior, cv2.COLOR_BGR2HSV)
lower_azul = np.array([100, 120, 150], dtype=np.uint8)
upper_azul = np.array([120, 255, 255], dtype=np.uint8)
mascara_fundo = cv2.inRange(recorte_hsv, lower_azul, upper_azul)
mascara_planta = cv2.bitwise_not(mascara_fundo)

# 4) Recortar apenas a regiao util da planta.
planta_sem_fundo = cv2.bitwise_and(recorte_superior, recorte_superior, mask=mascara_planta)
x, y, w, h = cv2.boundingRect(mascara_planta)
margem = 50
x0 = max(0, x - margem)
y0 = max(0, y - margem)
x1 = min(planta_sem_fundo.shape[1], x + w + margem)
y1 = min(planta_sem_fundo.shape[0], y + h + margem)
imagem_cortada_bgr = planta_sem_fundo[y0:y1, x0:x1]

# 5) Gerar mascara binaria simples das folhas em HSV.
imagem_cortada_hsv = cv2.cvtColor(imagem_cortada_bgr, cv2.COLOR_BGR2HSV)
mascara_folhas = cv2.inRange(imagem_cortada_hsv, (25, 40, 30), (95, 255, 255))

# 6) Limpeza morfologica simples para reduzir ruido.
kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3))
mascara_folhas = cv2.morphologyEx(mascara_folhas, cv2.MORPH_OPEN, kernel)
mascara_folhas = cv2.morphologyEx(mascara_folhas, cv2.MORPH_CLOSE, kernel)

# 7) Gerar skeleton da mascara.
# Skeleton = representacao afinada (1 pixel de largura) da estrutura da planta.
mascara_bool = mascara_folhas > 0
skeleton_bool = skeletonize(mascara_bool)
skeleton = np.uint8(skeleton_bool) * 255

# 8) Detectar endpoints no skeleton.
# Endpoint = pixel do skeleton que tem apenas 1 vizinho conectado.
kernel_vizinhos = np.array(
    [[1, 1, 1],
     [1, 0, 1],
     [1, 1, 1]],
    dtype=np.uint8,
)
vizinhos = cv2.filter2D(np.uint8(skeleton_bool), -1, kernel_vizinhos)
endpoints_bool = np.logical_and(skeleton_bool, vizinhos == 1)
endpoints = np.uint8(endpoints_bool) * 255

# 9) Contar endpoints.
# Como pontas de folhas tendem a aparecer como endpoints,
# usamos essa contagem como estimativa simples do numero de folhas.
numero_pontas = int(np.count_nonzero(endpoints))
estimativa_folhas = numero_pontas
print(f"Endpoints detectados: {numero_pontas}")
print(f"Estimativa simples de folhas: {estimativa_folhas}")

# 10) Destacar endpoints em vermelho na imagem.
endpoints_vis = cv2.dilate(endpoints, np.ones((5, 5), np.uint8), iterations=1)
imagem_pontas_bgr = imagem_cortada_bgr.copy()
imagem_pontas_bgr[endpoints_vis > 0] = (0, 0, 255)

# 11) Mostrar: original, mascara, skeleton e pontas detectadas.
plt.figure(figsize=(14, 8))

plt.subplot(2, 2, 1)
plt.imshow(cv2.cvtColor(img_1, cv2.COLOR_BGR2RGB))
plt.title("Imagem Original")
plt.axis("off")

plt.subplot(2, 2, 2)
plt.imshow(mascara_folhas, cmap="gray")
plt.title("Mascara das Folhas")
plt.axis("off")

plt.subplot(2, 2, 3)
plt.imshow(skeleton, cmap="gray")
plt.title("Skeleton")
plt.axis("off")

plt.subplot(2, 2, 4)
plt.imshow(cv2.cvtColor(imagem_pontas_bgr, cv2.COLOR_BGR2RGB))
plt.title("Pontas Detectadas (Vermelho)")
plt.axis("off")

plt.tight_layout()
plt.show()
